<?xml version="1.0" encoding="UTF-8"?>
<!--
    FLOW: Case Auto-Close After Resolution
    TRIGGER: When a Case Status is changed to "Resolved"
    ACTION: Waits 72 hours, then sets Status to "Closed" if it's still "Resolved"
    TYPE: Record-Triggered Flow (After Save, Update)
-->
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <label>Case — Auto-Close 72h After Resolution</label>
    <status>Active</status>
    <description>Automatically closes a Case 72 hours after it is marked as Resolved, if the customer has not reopened it.</description>
    <processType>AutoLaunchedFlow</processType>
    <triggerType>RecordAfterSave</triggerType>
    <recordTriggerType>Update</recordTriggerType>
    <objectType>Case</objectType>

    <start>
        <locationX>176</locationX>
        <locationY>48</locationY>
        <connector>
            <targetReference>Wait_72_Hours</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Status</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Resolved</stringValue>
            </value>
        </filters>
        <object>Case</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>

    <waits>
        <name>Wait_72_Hours</name>
        <label>Wait 72 Hours</label>
        <locationX>176</locationX>
        <locationY>168</locationY>
        <waitEvents>
            <name>After_72_Hours</name>
            <conditionLogic>and</conditionLogic>
            <connector>
                <targetReference>Check_Still_Resolved</targetReference>
            </connector>
            <eventType>AlarmEvent</eventType>
            <label>72 Hours After Resolution</label>
            <offset>72</offset>
            <offsetUnit>Hours</offsetUnit>
            <resumeDate>$Record.LastModifiedDate</resumeDate>
        </waitEvents>
    </waits>

    <decisions>
        <name>Check_Still_Resolved</name>
        <label>Still Resolved?</label>
        <locationX>176</locationX>
        <locationY>288</locationY>
        <defaultConnectorLabel>Status Changed — Skip</defaultConnectorLabel>
        <rules>
            <name>Still_Resolved</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Resolved</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Close_The_Case</targetReference>
            </connector>
            <label>Still Resolved</label>
        </rules>
    </decisions>

    <recordUpdates>
        <name>Close_The_Case</name>
        <label>Close The Case</label>
        <locationX>176</locationX>
        <locationY>408</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>Closed</stringValue>
            </value>
        </inputAssignments>
        <object>Case</object>
    </recordUpdates>
</Flow>
