<?xml version="1.0" encoding="UTF-8"?>
<!--
    FLOW: Lead Inactivity Alert To Owner
    TRIGGER: Scheduled — runs daily at 9am
    ACTION: Finds open Leads with no activity in the last 7 days,
            sends a nudge email to the Lead Owner
    TYPE: Scheduled-Triggered Flow
-->
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <label>Lead — Inactivity Alert After 7 Days</label>
    <status>Active</status>
    <description>Sends a daily nudge email to sales reps who have open Leads with no LastActivityDate in the past 7 days.</description>
    <processType>AutoLaunchedFlow</processType>
    <triggerType>Scheduled</triggerType>

    <start>
        <locationX>176</locationX>
        <locationY>48</locationY>
        <connector>
            <targetReference>Get_Inactive_Leads</targetReference>
        </connector>
        <schedule>
            <frequency>Daily</frequency>
            <startDate>2024-01-01</startDate>
            <startTime>09:00:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>

    <recordLookups>
        <name>Get_Inactive_Leads</name>
        <label>Get Inactive Leads</label>
        <locationX>176</locationX>
        <locationY>168</locationY>
        <connector>
            <targetReference>Loop_Inactive_Leads</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>IsConverted</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Status</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Closed - Not Converted</stringValue>
            </value>
        </filters>
        <filters>
            <field>LastActivityDate</field>
            <operator>LessThanOrEqualTo</operator>
            <value>
                <elementReference>SevenDaysAgo</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Lead</object>
        <outputReference>Inactive_Leads</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>FirstName</queriedFields>
        <queriedFields>LastName</queriedFields>
        <queriedFields>Company</queriedFields>
        <queriedFields>LastActivityDate</queriedFields>
        <queriedFields>Owner.Email</queriedFields>
        <queriedFields>Owner.FirstName</queriedFields>
    </recordLookups>

    <loops>
        <name>Loop_Inactive_Leads</name>
        <label>Loop Inactive Leads</label>
        <locationX>176</locationX>
        <locationY>288</locationY>
        <collectionReference>Inactive_Leads</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Send_Inactivity_Alert</targetReference>
        </nextValueConnector>
    </loops>

    <actionCalls>
        <name>Send_Inactivity_Alert</name>
        <label>Send Inactivity Alert</label>
        <locationX>440</locationX>
        <locationY>288</locationY>
        <actionName>emailSimple</actionName>
        <actionType>emailSimple</actionType>
        <connector>
            <targetReference>Loop_Inactive_Leads</targetReference>
        </connector>
        <inputParameters>
            <name>emailAddresses</name>
            <value>
                <elementReference>Loop_Inactive_Leads.CurrentItem.Owner.Email</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailSubject</name>
            <value>
                <stringValue>Lead Going Cold — {!Loop_Inactive_Leads.CurrentItem.FirstName} {!Loop_Inactive_Leads.CurrentItem.LastName} at {!Loop_Inactive_Leads.CurrentItem.Company}</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailBody</name>
            <value>
                <stringValue>Hi {!Loop_Inactive_Leads.CurrentItem.Owner.FirstName},

This lead has had no activity in the past 7 days:

Name    : {!Loop_Inactive_Leads.CurrentItem.FirstName} {!Loop_Inactive_Leads.CurrentItem.LastName}
Company : {!Loop_Inactive_Leads.CurrentItem.Company}
Last Activity: {!Loop_Inactive_Leads.CurrentItem.LastActivityDate}

Please log a call, send an email, or update the Lead status.

This is an automated reminder from Salesforce.</stringValue>
            </value>
        </inputParameters>
    </actionCalls>

    <formulas>
        <name>SevenDaysAgo</name>
        <dataType>Date</dataType>
        <expression>TODAY() - 7</expression>
    </formulas>

    <variables>
        <name>Inactive_Leads</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Lead</objectType>
    </variables>
</Flow>
