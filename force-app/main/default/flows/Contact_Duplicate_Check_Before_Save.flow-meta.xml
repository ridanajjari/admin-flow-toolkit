<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <customErrors>
        <name>Show_Duplicate_Error</name>
        <label>Show Duplicate Error</label>
        <locationX>176</locationX>
        <locationY>500</locationY>
        <customErrorMessages>
            <errorMessage>A Contact with this email address already exists: {!Existing_Contact.Name}. Please search for the existing record instead of creating a duplicate.</errorMessage>
            <fieldSelection>Email</fieldSelection>
            <isFieldError>true</isFieldError>
        </customErrorMessages>
    </customErrors>
    <customErrors>
        <name>Show_Lookup_Fault</name>
        <label>Show Lookup Fault</label>
        <locationX>440</locationX>
        <locationY>300</locationY>
        <customErrorMessages>
            <errorMessage>The duplicate email check could not run: {!$Flow.FaultMessage}</errorMessage>
            <isFieldError>false</isFieldError>
        </customErrorMessages>
    </customErrors>
    <decisions>
        <name>Is_Duplicate</name>
        <label>Duplicate Found?</label>
        <locationX>176</locationX>
        <locationY>400</locationY>
        <defaultConnectorLabel>No Duplicate</defaultConnectorLabel>
        <rules>
            <name>Duplicate_Exists</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Existing_Contact</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Show_Duplicate_Error</targetReference>
            </connector>
            <label>Duplicate exists</label>
        </rules>
    </decisions>
    <description>Before-save check that blocks creating a Contact when another Contact already has the same email address (exact match, insert only). If the lookup faults, the save is blocked and the fault message is shown.</description>
    <environments>Default</environments>
    <label>Contact — Duplicate Email Check Before Save</label>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Find_Existing_Contact_With_Same_Email</name>
        <label>Find Existing Contact With Same Email</label>
        <locationX>176</locationX>
        <locationY>200</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Is_Duplicate</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Show_Lookup_Fault</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Email</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Email</elementReference>
            </value>
        </filters>
        <object>Contact</object>
        <outputReference>Existing_Contact</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Name</queriedFields>
    </recordLookups>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Find_Existing_Contact_With_Same_Email</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Email</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>Contact</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Draft</status>
    <variables>
        <name>Existing_Contact</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Contact</objectType>
    </variables>
</Flow>
