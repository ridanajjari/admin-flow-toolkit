<?xml version="1.0" encoding="UTF-8"?>
<!--
    FLOW: Contact Duplicate Check Before Save
    TRIGGER: Before a Contact is created
    ACTION: Checks if a Contact with the same Email already exists.
            If yes, shows a validation error and blocks the save.
    TYPE: Record-Triggered Flow (Before Save, Insert only)
-->
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>59.0</apiVersion>
    <label>Contact — Duplicate Email Check Before Save</label>
    <status>Active</status>
    <description>Prevents saving a new Contact if another Contact with the same email address already exists in the org.</description>
    <processType>AutoLaunchedFlow</processType>
    <triggerType>RecordBeforeSave</triggerType>
    <recordTriggerType>Create</recordTriggerType>
    <objectType>Contact</objectType>

    <start>
        <locationX>176</locationX>
        <locationY>48</locationY>
        <connector>
            <targetReference>Check_Email_Is_Not_Blank</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <object>Contact</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>

    <decisions>
        <name>Check_Email_Is_Not_Blank</name>
        <label>Email Is Not Blank?</label>
        <locationX>176</locationX>
        <locationY>168</locationY>
        <defaultConnectorLabel>No Email — Skip</defaultConnectorLabel>
        <rules>
            <name>Email_Provided</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Email</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Find_Existing_Contact_With_Same_Email</targetReference>
            </connector>
            <label>Email provided</label>
        </rules>
    </decisions>

    <recordLookups>
        <name>Find_Existing_Contact_With_Same_Email</name>
        <label>Find Existing Contact With Same Email</label>
        <locationX>176</locationX>
        <locationY>288</locationY>
        <connector>
            <targetReference>Is_Duplicate</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Email</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Email</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Contact</object>
        <outputReference>Existing_Contact</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Name</queriedFields>
    </recordLookups>

    <decisions>
        <name>Is_Duplicate</name>
        <label>Duplicate Found?</label>
        <locationX>176</locationX>
        <locationY>408</locationY>
        <defaultConnectorLabel>No Duplicate</defaultConnectorLabel>
        <rules>
            <name>Duplicate_Exists</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Existing_Contact</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Show_Duplicate_Error</targetReference>
            </connector>
            <label>Duplicate exists</label>
        </rules>
    </decisions>

    <customErrors>
        <name>Show_Duplicate_Error</name>
        <label>Show Duplicate Error</label>
        <locationX>440</locationX>
        <locationY>408</locationY>
        <customErrorMessages>
            <errorMessage>A Contact with this email address already exists: {!Existing_Contact.Name}. Please search for the existing record instead of creating a duplicate.</errorMessage>
            <isFieldError>true</isFieldError>
            <fieldSelection>Email</fieldSelection>
        </customErrorMessages>
    </customErrors>

    <variables>
        <name>Existing_Contact</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Contact</objectType>
    </variables>
</Flow>
