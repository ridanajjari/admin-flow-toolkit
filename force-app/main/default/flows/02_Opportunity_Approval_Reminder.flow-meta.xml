<?xml version="1.0" encoding="UTF-8"?>
<!--
    FLOW: Opportunity Approval Reminder
    TRIGGER: Scheduled — runs daily
    ACTION: Sends a reminder email for Opportunities stuck in pending approval > 48 hours
    TYPE: Scheduled-Triggered Flow
-->
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>59.0</apiVersion>
    <label>Opportunity — Pending Approval Reminder</label>
    <status>Active</status>
    <description>Sends a daily reminder email to Opportunity owners whose records have been pending approval for more than 48 hours.</description>
    <processType>AutoLaunchedFlow</processType>
    <triggerType>Scheduled</triggerType>

    <start>
        <locationX>176</locationX>
        <locationY>48</locationY>
        <connector>
            <targetReference>Get_Stale_Pending_Opportunities</targetReference>
        </connector>
        <schedule>
            <frequency>Daily</frequency>
            <startDate>2024-01-01</startDate>
            <startTime>08:00:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>

    <recordLookups>
        <name>Get_Stale_Pending_Opportunities</name>
        <label>Get Stale Pending Opportunities</label>
        <locationX>176</locationX>
        <locationY>168</locationY>
        <connector>
            <targetReference>Loop_Opportunities</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Approval_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Pending</stringValue>
            </value>
        </filters>
        <filters>
            <field>Submitted_For_Approval_Date__c</field>
            <operator>LessThan</operator>
            <value>
                <elementReference>$Flow.CurrentDateTime</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Opportunity</object>
        <outputReference>Pending_Opportunities</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Name</queriedFields>
        <queriedFields>OwnerId</queriedFields>
        <queriedFields>Owner.Email</queriedFields>
        <queriedFields>Owner.FirstName</queriedFields>
        <queriedFields>Amount</queriedFields>
    </recordLookups>

    <loops>
        <name>Loop_Opportunities</name>
        <label>Loop Opportunities</label>
        <locationX>176</locationX>
        <locationY>288</locationY>
        <collectionReference>Pending_Opportunities</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Send_Reminder_Email</targetReference>
        </nextValueConnector>
    </loops>

    <actionCalls>
        <name>Send_Reminder_Email</name>
        <label>Send Reminder Email</label>
        <locationX>440</locationX>
        <locationY>288</locationY>
        <actionName>emailSimple</actionName>
        <actionType>emailSimple</actionType>
        <connector>
            <targetReference>Loop_Opportunities</targetReference>
        </connector>
        <inputParameters>
            <name>emailAddresses</name>
            <value>
                <elementReference>Loop_Opportunities.CurrentItem.Owner.Email</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailSubject</name>
            <value>
                <stringValue>ACTION NEEDED — Opportunity Pending Approval: {!Loop_Opportunities.CurrentItem.Name}</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailBody</name>
            <value>
                <stringValue>Hi {!Loop_Opportunities.CurrentItem.Owner.FirstName},

Your opportunity has been pending approval for more than 48 hours.

Opportunity : {!Loop_Opportunities.CurrentItem.Name}
Amount      : {!Loop_Opportunities.CurrentItem.Amount}

Please follow up with your approver or resubmit if needed.

This is an automated reminder from Salesforce.</stringValue>
            </value>
        </inputParameters>
    </actionCalls>

    <variables>
        <name>Pending_Opportunities</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Opportunity</objectType>
    </variables>
</Flow>
