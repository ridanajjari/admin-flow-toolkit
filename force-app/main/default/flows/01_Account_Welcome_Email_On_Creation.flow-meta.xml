<?xml version="1.0" encoding="UTF-8"?>
<!--
    FLOW: Account Welcome Email On Creation
    TRIGGER: After a new Account is created
    ACTION: Sends a welcome email to the Account Owner
    TYPE: Record-Triggered Flow (After Save, Insert only)
-->
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <label>Account — Welcome Email on Creation</label>
    <status>Active</status>
    <description>Sends a welcome email to the Account Owner when a new Account record is created.</description>
    <processType>AutoLaunchedFlow</processType>
    <triggerType>RecordAfterSave</triggerType>
    <recordTriggerType>Create</recordTriggerType>
    <objectType>Account</objectType>

    <start>
        <locationX>176</locationX>
        <locationY>48</locationY>
        <connector>
            <targetReference>Send_Welcome_Email</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <object>Account</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>

    <actionCalls>
        <name>Send_Welcome_Email</name>
        <label>Send Welcome Email</label>
        <locationX>176</locationX>
        <locationY>168</locationY>
        <actionName>emailSimple</actionName>
        <actionType>emailSimple</actionType>
        <inputParameters>
            <name>emailAddresses</name>
            <value>
                <elementReference>$Record.Owner.Email</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailSubject</name>
            <value>
                <stringValue>New Account Created: {!$Record.Name}</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailBody</name>
            <value>
                <stringValue>Hi {!$Record.Owner.FirstName},

A new Account has been created and assigned to you.

Account Name : {!$Record.Name}
Industry     : {!$Record.Industry}
Phone        : {!$Record.Phone}
Website      : {!$Record.Website}

Please review the record and complete any missing information.

This is an automated message from Salesforce.</stringValue>
            </value>
        </inputParameters>
    </actionCalls>
</Flow>
